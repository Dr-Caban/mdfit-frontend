{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/data/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/:page(account|book|login|admin|workspace|workspace-preview|cancel|intake)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/account",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/workspace",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/workspace-preview",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/cancel",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/intake",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://js.stripe.com; frame-src 'self' https://js.stripe.com https://checkout.stripe.com https://hooks.stripe.com https://accounts.google.com https://drive.google.com https://cal.com https://app.cal.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.stripe.com https://*.googletagmanager.com https://va.vercel-scripts.com https://cdn.jsdelivr.net https://accounts.google.com https://apis.google.com https://app.cal.com; connect-src 'self' https://api.stripe.com https://amiable-peace-production-e382.up.railway.app https://*.vercel.app https://va.vercel-scripts.com https://vitals.vercel-insights.com wss://amiable-peace-production-e382.up.railway.app https://app.cal.com https://accounts.google.com https://oauth2.googleapis.com; img-src 'self' data: https:; media-src 'self' blob: https://res.cloudinary.com https://drive.usercontent.google.com https://drive.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com https://billing.stripe.com; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/sciatica-treatment-sarasota",
      "destination": "/conditions/sciatica",
      "permanent": true
    },
    {
      "source": "/medical-massage-sarasota",
      "destination": "/treatments/medical-massage",
      "permanent": true
    },
    {
      "source": "/chronic-pain-sarasota",
      "destination": "/conditions/chronic-pain",
      "permanent": true
    },
    {
      "source": "/conditions/medical-massage",
      "destination": "/treatments/medical-massage",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/evaluation",
      "destination": "/book?type=eval",
      "permanent": false
    },
    {
      "source": "/call",
      "destination": "/book?type=call",
      "permanent": false
    },
    {
      "source": "/consult",
      "destination": "/#intake",
      "permanent": false
    },
    {
      "source": "/assets/pain/guide-:id-thumb.webp",
      "destination": "/assets/guides/:id-thumb.webp",
      "permanent": false
    },
    {
      "source": "/assets/pain/guide-:id.webp",
      "destination": "/assets/guides/:id-anatomy.webp",
      "permanent": false
    },
    {
      "source": "/assets/pain/body-map:size.webp",
      "destination": "/assets/pain/body-figures.webp",
      "permanent": false
    }
  ]
}
